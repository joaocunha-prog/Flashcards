# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL — Supabase ou Postgres local)
# ---------------------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string > URI.
# Use a porta 6543 (pooler) em DATABASE_URL e a 5432 (direta) em DIRECT_URL —
# migrations não funcionam através do pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/banco_questoes_enare"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/banco_questoes_enare"

# ---------------------------------------------------------------------------
# Claude — explicações sob demanda
# ---------------------------------------------------------------------------
# Sem esta chave o app funciona normalmente; apenas o botão
# "Explicar com Claude" retorna erro orientando a configurá-la.
ANTHROPIC_API_KEY=""
# Opcional: sobrescreve o modelo usado pela IA.
# Padrão: claude-sonnet-5 nas explicações e claude-opus-5 na geração de provas.
# Definir esta variável sobrescreve os dois.
# ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Supabase Auth (opcional)
# ---------------------------------------------------------------------------
# Sem estas variáveis o app roda em modo local single-user: todo o progresso
# fica atribuído a um usuário fixo. Preencha para ativar contas de verdade.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Importação administrativa
# ---------------------------------------------------------------------------
# Segredo exigido por POST /api/admin/import e /api/admin/recompute.
# Enquanto estiver vazio, essas rotas ficam desligadas (retornam 503).
ADMIN_IMPORT_TOKEN=""
