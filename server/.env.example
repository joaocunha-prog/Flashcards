PORT=3000

# Token que você escolhe e usa também no campo "Verify Token" do webhook no Meta for Developers
WHATSAPP_VERIFY_TOKEN=escolha-um-token-secreto

# Meta for Developers > seu app > WhatsApp > API Setup > Temporary access token (ou token permanente)
WHATSAPP_ACCESS_TOKEN=

# Meta for Developers > seu app > WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# Meta for Developers > seu app > App settings > Basic > App secret (usado para validar a assinatura do webhook)
WHATSAPP_APP_SECRET=

# Números autorizados a lançar gastos por WhatsApp, separados por vírgula, no formato E.164 sem "+" (ex: 5521999999999).
# Deixe vazio para aceitar mensagens de qualquer número (não recomendado).
WHATSAPP_ALLOWED_SENDERS=
